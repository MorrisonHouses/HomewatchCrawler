# The public URL of the installed Laravel HomeWatch site; no trailing slash.
HOMEWATCH_APP_URL=https://your-domain.example
# Must exactly match HOMEWATCH_CRAWLER_TOKEN in the Laravel .env file.
HOMEWATCH_CRAWLER_TOKEN=

# Same OpenAI key used by the dashboard Insights feature.
OPENAI_API_KEY=
HOMEWATCH_AI_ENABLED=true
HOMEWATCH_AI_MODEL=gpt-5.6-luna
HOMEWATCH_AI_FALLBACK_MODEL=gpt-5.6-terra
HOMEWATCH_AI_MODE=hybrid
HOMEWATCH_AI_MAX_CALLS=20
HOMEWATCH_AI_MAX_COST_USD=1.00
HOMEWATCH_POLL_SECONDS=20
